{
  "version": 4,
  "configurePresets": [
    {
      "name": "host-tests",
      "displayName": "NXSync host tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-tests"
    }
  ],
  "buildPresets": [
    {
      "name": "host-tests",
      "configurePreset": "host-tests"
    }
  ],
  "testPresets": [
    {
      "name": "host-tests",
      "configurePreset": "host-tests",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
