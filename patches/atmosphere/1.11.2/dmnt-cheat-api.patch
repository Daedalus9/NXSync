+        bool NxsyncReadDecision(const u64 sequence, const char *action) {
+            char text[1024] = {}, expected[128] = {};
+            if (!NxsyncReadProtocol(NxsyncLaunchDecisionPath, text, sizeof(text))) return false;
+            const int length = util::SNPrintf(expected, sizeof(expected),
+                "version=2\nsequence=%lu\naction=%s\nmessage=", sequence, action);
+            if (length <= 0 || std::strncmp(text, expected, length) != 0) return false;
+            // Messages escape newlines: reject duplicate/extra fields and prefix matches.
+            return std::strchr(text + length, '\n') == text + std::strlen(text) - 1;
+        }
