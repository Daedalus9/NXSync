+                R_SUCCEED();
+            }
+            char actual[192] = {};
+            R_TRY(fs::ReadFile(file, 0, actual, expected_length));
+            *matches = std::memcmp(actual, expected, expected_length) == 0;
+            R_SUCCEED();
+        }
