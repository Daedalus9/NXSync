+        Result NxsyncDeleteIfPresentWithRetry(const char *path) {
+            Result result = fs::DeleteFile(path);
+            for (int attempt = 0;
+                 attempt < NxsyncPublishRetryCount
+                    && fs::ResultTargetLocked::Includes(result);
+                 ++attempt) {
+                os::SleepThread(NxsyncPublishRetryInterval);
+                result = fs::DeleteFile(path);
+            }
+            if (R_SUCCEEDED(result) || fs::ResultPathNotFound::Includes(result)) {
+                return ResultSuccess();
+            }
+            return result;
+        }
+
+        Result NxsyncRenameWithRetry(const char *source, const char *target) {
+            Result result = fs::RenameFile(source, target);
+            for (int attempt = 0;
+                 attempt < NxsyncPublishRetryCount
+                    && fs::ResultTargetLocked::Includes(result);
+                 ++attempt) {
+                os::SleepThread(NxsyncPublishRetryInterval);
+                result = fs::RenameFile(source, target);
+            }
+            return result;
+        }
