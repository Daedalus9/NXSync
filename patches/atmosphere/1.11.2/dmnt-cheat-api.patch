+        bool NxsyncReadProtocol(const char *path, char *text, size_t capacity) {
+            fs::FileHandle file;
+            if (R_FAILED(fs::OpenFile(std::addressof(file), path, fs::OpenMode_Read))) return false;
+            ON_SCOPE_EXIT { fs::CloseFile(file); };
+            s64 size = 0;
+            if (R_FAILED(fs::GetFileSize(std::addressof(size), file))
+                || size <= 0 || size >= static_cast<s64>(capacity)) return false;
+            if (R_FAILED(fs::ReadFile(file, 0, text, size))) return false;
+            text[size] = 0;
+            return text[size - 1] == '\n' && std::strlen(text) == static_cast<size_t>(size);
+        }
