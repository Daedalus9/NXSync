+        // Starting under a debugger stops the initial thread before any user code,
+        // while moving out of Created (where the kernel rejects HOME termination).
+        // Closing the handle releases the hold; transfer it to dmnt if cheats are used.
+        class NxsyncLaunchHold {
+            private:
+                svc::Handle m_handle = svc::InvalidHandle;
+                bool m_started = false;
+            public:
+                NxsyncLaunchHold() = default;
+                NxsyncLaunchHold(const NxsyncLaunchHold &) = delete;
+                NxsyncLaunchHold &operator=(const NxsyncLaunchHold &) = delete;
+                ~NxsyncLaunchHold() {
+                    if (m_handle != svc::InvalidHandle) os::CloseNativeHandle(m_handle);
+                }
+                Result Begin(const os::ProcessId process_id) {
+                    R_TRY(svc::DebugActiveProcess(&m_handle, process_id.value));
+                    R_TRY(pm::dmnt::StartProcess(process_id));
+                    m_started = true;
+                    R_SUCCEED();
+                }
+                bool Started() const { return m_started; }
+                void Cancel() {
+                    // Do not detach/resume before termination, especially after a grant.
+                    const Result result = svc::TerminateDebugProcess(m_handle);
+                    AMS_UNUSED(result);
+                }
+                svc::Handle TakeHandle() {
+                    const auto handle = m_handle;
+                    m_handle = svc::InvalidHandle;
+                    return handle;
+                }
+        };
