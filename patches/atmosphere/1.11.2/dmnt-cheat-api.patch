+        bool NxsyncWriteLaunchRequest(
+            const os::ProcessId process_id,
+            const ncm::ProgramId program_id) {
+            char text[192];
+            const u64 sequence = process_id.value;
+            const int length = util::SNPrintf(
+                text,
+                sizeof(text),
+                "version=2\nsequence=%lu\nprocess_id=%lu\ntitle_id=%016lX\n",
+                sequence,
+                process_id.value,
+                program_id.value);
+            if (length <= 0 || static_cast<size_t>(length) >= sizeof(text)) {
+                NxsyncWriteLaunchPublishStatus(
+                    "error", "format", sequence, process_id, program_id, 0);
+                return false;
+            }
+            Result result = NxsyncWriteClosedFile(
+                NxsyncLaunchRequestPendingPath,
+                text,
+                static_cast<size_t>(length));
+            if (R_FAILED(result)) {
+                NxsyncWriteLaunchPublishStatus(
+                    "error", "write-pending", sequence, process_id,
+                    program_id, result.GetValue());
+                return false;
+            }
+
+            bool matches = false;
+            result = NxsyncVerifyClosedFile(
+                NxsyncLaunchRequestPendingPath,
+                text,
+                static_cast<size_t>(length),
+                std::addressof(matches));
+            if (R_FAILED(result) || !matches) {
+                NxsyncWriteLaunchPublishStatus(
+                    "error", "verify-pending", sequence, process_id,
+                    program_id, R_FAILED(result) ? result.GetValue() : 0);
+                return false;
+            }
+
+            result = NxsyncDeleteIfPresentWithRetry(NxsyncLaunchRequestPath);
+            if (R_FAILED(result)) {
+                NxsyncWriteLaunchPublishStatus(
+                    "error", "delete-current", sequence, process_id,
+                    program_id, result.GetValue());
+                return false;
+            }
+            result = NxsyncRenameWithRetry(
+                NxsyncLaunchRequestPendingPath,
+                NxsyncLaunchRequestPath);
+            if (R_FAILED(result)) {
+                NxsyncWriteLaunchPublishStatus(
+                    "error", "publish", sequence, process_id,
+                    program_id, result.GetValue());
+                return false;
+            }
+
+            matches = false;
+            result = NxsyncVerifyClosedFile(
+                NxsyncLaunchRequestPath,
+                text,
+                static_cast<size_t>(length),
+                std::addressof(matches));
+            if (R_FAILED(result) || !matches) {
+                NxsyncDeleteIfPresent(NxsyncLaunchRequestPath);
+                NxsyncWriteLaunchPublishStatus(
+                    "error", "verify-published", sequence, process_id,
+                    program_id, R_FAILED(result) ? result.GetValue() : 0);
