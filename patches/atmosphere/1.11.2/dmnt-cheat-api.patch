+        bool NxsyncRunLaunchGate(
+            const os::ProcessId process_id,
+            const ncm::ProgramId program_id,
+            const os::NativeHandle process_handle) {
+            // The persistent marker is checked even if automations are disabled.
+            // Other titles can run (including a full-memory recovery NRO), but
+            // no further automatic restore is offered until recovery completes.
+            if (NxsyncRestoreGuardExists()) return !NxsyncGuardBlocksTitle(program_id);
+            if (!NxsyncFileExists(NxsyncGateEnabledPath)) return true;
+
+            const char *ephemeral[] = {NxsyncLaunchDecisionPath, NxsyncLaunchActionPath,
+                NxsyncOverlayRequestPath, NxsyncPreflightRequestPath, NxsyncPreflightStatusPath,
+                NxsyncRestoreClaimPath, NxsyncRestoreGrantPath, NxsyncLaunchPhasePath};
+            for (const auto path : ephemeral) {
+                char backup[160];
+                util::SNPrintf(backup, sizeof(backup), "%s.bak", path);
+                // Stale grants must be removed successfully before publishing a session.
+                if (R_FAILED(NxsyncDeleteIfPresentWithRetry(backup))
+                    || R_FAILED(NxsyncDeleteIfPresentWithRetry(path))) return false;
+            }
+            ON_SCOPE_EXIT {
+                NxsyncDeleteIfPresent(NxsyncRestoreGrantPath);
+                NxsyncDeleteIfPresent(NxsyncLaunchRequestPath);
+                NxsyncDeleteIfPresent(NxsyncLaunchPhasePath);
+            };
+            if (!NxsyncWriteLaunchRequest(process_id, program_id)) return true;
+
+            os::Tick phase_start = os::GetSystemTick();
+            auto timeout = NxsyncGateTimeout;
+            int phase = 0; // checking -> choice -> download; never reset a phase deadline.
+            bool restore_granted = false;
+            while (true) {
+                if (NxsyncProcessClosing(process_handle)) return false;
+                if (NxsyncReadDecision(process_id.value, "abort")) return false;
+                if (NxsyncReadDecision(process_id.value, "allow")) return !NxsyncRestoreGuardExists();
+                const auto now = os::GetSystemTick();
+                const auto elapsed = (now - phase_start).ToTimeSpan();
+                // A late phase or claim cannot revive an expired session.
+                if (!restore_granted && elapsed >= timeout) return true;
+                if (restore_granted && elapsed >= TimeSpan::FromMinutes(30)) return false;
+                if (!restore_granted) {
+                    if (phase < 2 && NxsyncReadPhase(process_id.value, "download")) {
+                        phase = 2;
+                        phase_start = now;
+                        timeout = NxsyncDownloadTimeout;
+                    } else if (phase == 0 && NxsyncReadPhase(process_id.value, "choice")) {
+                        phase = 1;
+                        phase_start = now;
+                        timeout = NxsyncChoiceTimeout;
+                    }
+                    char claim[192] = {};
+                    if (NxsyncReadRestoreClaim(process_id, program_id, claim, sizeof(claim))) {
+                        if (NxsyncRestoreGuardExists()) return false;
+                        const auto length = std::strlen(claim);
+                        // Flush and verify the persistent guard BEFORE publishing the grant.
+                        if (R_FAILED(NxsyncWriteClosedFile(NxsyncRestoreGuardPath, claim, length))) return false;
+                        bool matches = false;
+                        if (R_FAILED(NxsyncVerifyClosedFile(NxsyncRestoreGuardPath, claim, length, &matches))
+                            || !matches) return false;
+                        restore_granted = true;
+                        phase_start = os::GetSystemTick();
+                        if (R_FAILED(NxsyncWriteClosedFile(NxsyncRestoreGrantPath, claim, length))) return false;
+                    }
+                }
+                os::SleepThread(NxsyncGatePollInterval);
+            }
+        }
