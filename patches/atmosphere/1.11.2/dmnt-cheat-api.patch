+        Result NxsyncWriteClosedFile(
+            const char *path,
+            const char *text,
+            const size_t length) {
+            R_TRY(NxsyncDeleteIfPresentWithRetry(path));
+            R_TRY(fs::CreateFile(path, length, fs::CreateOption_None));
+            {
+                fs::FileHandle file;
+                R_TRY(fs::OpenFile(
+                    std::addressof(file), path, fs::OpenMode_Write));
+                ON_SCOPE_EXIT { fs::CloseFile(file); };
+                R_TRY(fs::WriteFile(
+                    file, 0, text, length, fs::WriteOption::Flush));
+            }
+            R_SUCCEED();
+        }
